<Window x:Class="TravelAgency.WPF.Views.ContractEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Договор" Height="380" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Номер договора:" Grid.Row="0" Margin="5"/>
        <TextBox x:Name="TxtNumber" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Выберите тур:" Grid.Row="1" Margin="5"/>
        <ComboBox x:Name="CmbTours" Grid.Row="1" Grid.Column="1" Margin="5"
                  DisplayMemberPath="TourName" SelectedValuePath="Id"/>

        <TextBlock Text="Сотрудник:" Grid.Row="2" Margin="5"/>
        <ComboBox x:Name="CmbEmployees" Grid.Row="2" Grid.Column="1" Margin="5"
                  DisplayMemberPath="FullName" SelectedValuePath="Id"/>

        <TextBlock Text="Дата договора:" Grid.Row="3" Margin="5"/>
        <DatePicker x:Name="DpDate" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="ФИО Заказчика:" Grid.Row="4" Margin="5"/>
        <TextBox x:Name="TxtCustomer" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Телефон заказчика:" Grid.Row="5" Margin="5"/>
        <TextBox x:Name="TxtPhone" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Стоимость (руб.):" Grid.Row="6" Margin="5"/>
        <TextBox x:Name="TxtCost" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" Width="90" Margin="5"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="90" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>