<Window x:Class="TravelAgency.WPF.Views.TourEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры тура" Height="400" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Номер тура:" Grid.Row="0" Margin="5"/>
        <TextBox x:Name="TxtTourNum" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Название тура:" Grid.Row="1" Margin="5"/>
        <TextBox x:Name="TxtTourName" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Место отдыха:" Grid.Row="2" Margin="5"/>
        <TextBox x:Name="TxtDestination" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Количество дней:" Grid.Row="3" Margin="5"/>
        <TextBox x:Name="TxtDays" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Дата начала:" Grid.Row="4" Margin="5"/>
        <DatePicker x:Name="DpStart" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Дата окончания:" Grid.Row="5" Margin="5"/>
        <DatePicker x:Name="DpEnd" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Класс отеля (1-5):" Grid.Row="6" Margin="5"/>
        <TextBox x:Name="TxtHotelClass" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Количество мест:" Grid.Row="7" Margin="5"/>
        <TextBox x:Name="TxtSeats" Grid.Row="7" Grid.Column="1" Margin="5"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" Width="90" Margin="5"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="90" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>